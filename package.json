{
  "name": "cnb-rates",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript client for the Czech National Bank (ČNB) daily FX fixing: exact decimal parsing, date resolution in Europe/Prague and conversions via CZK.",
  "author": "Gildor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gildor853/cnb-rates.git"
  },
  "homepage": "https://github.com/gildor853/cnb-rates#readme",
  "bugs": {
    "url": "https://github.com/gildor853/cnb-rates/issues"
  },
  "keywords": [
    "cnb",
    "czech-national-bank",
    "exchange-rates",
    "fx",
    "czk",
    "kurzy",
    "kurzovni-listek",
    "currency"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "vite": "^6.4.4"
  }
}
